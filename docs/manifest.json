{
  "name": "GLB Viewer",
  "short_name": "GLB Viewer",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#202020",
  "theme_color": "#202020",
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".glb",
            "model/gltf-binary",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}